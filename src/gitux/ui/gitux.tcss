Screen {
    background: #181622;
}

* {
    color: #e6e0f1;
}

#top-bar {
    dock: top;
    height: 1;
    background: #1c1a26;
    color: #e6e0f1;
    padding: 0 1;
    text-style: bold;
}

#stats-bar {
    dock: top;
    height: 3;
    background: #0f0d18;
    color: #cbc3d7;
    border: round #494454;
    padding: 0 1;
}

#stats-left {
    width: 1fr;
    height: 1;
    content-align: left middle;
}

#stats-second {
    height: 1;
    layout: horizontal;
}

#stats-sync {
    width: 1fr;
    height: 1;
    content-align: left middle;
}

#stats-steps {
    width: auto;
    height: 1;
    content-align: right middle;
    padding: 0 1;
}

#main-content {
    height: 1fr;
    layout: vertical;
}

#bento-top {
    height: 1fr;
    layout: horizontal;
}

#files-block {
    width: 2fr;
    min-width: 30;
}

#diff-block {
    width: 3fr;
    min-width: 30;
}

.block-active {
    border: round #8B5CF6;
    background: #0f0d18;
}

.block-inactive {
    border: round #494454;
    background: #0f0d18;
}

.block-header {
    height: 1;
    background: #201e2a;
    padding: 0 1;
    text-style: bold;
}

.block-active .block-header {
    color: #e6e0f1;
}

.block-inactive .block-header {
    color: #cbc3d7;
}

#changed-files {
    height: 1fr;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 0 1;
    background: transparent;
    scrollbar-visibility: hidden;
}

.staged-section {
    color: #06B6D4;
}

.unstaged-section {
    color: #ffb783;
}

.file-status-M { color: #ffb783; }
.file-status-A { color: #10B981; }
.file-status-D { color: #ffb4ab; }
.file-status-R { color: #06B6D4; }
.file-status-C { color: #06B6D4; }
.file-status-unknown { color: #958ea0; }

#diff-viewer {
    height: 1fr;
    overflow-y: auto;
    padding: 0 1;
    background: transparent;
    scrollbar-visibility: hidden;
}

#commit-modal {
    background: #0f0d18;
    border: round #8B5CF6;
    color: #e6e0f1;
    width: 60%;
    height: 13;
}

#help-container {
    background: #0f0d18;
    border: round #8B5CF6;
    color: #e6e0f1;
    width: 64;
    max-width: 90%;
    max-height: 85%;
    padding: 0;
    overflow-y: auto;
}

#help-title {
    text-style: bold;
    color: #e6e0f1;
    text-align: center;
    background: #201e2a;
    padding: 0 1;
    height: 1;
}

#help-body {
    color: #e6e0f1;
    padding: 0 1;
}

#help-body .key {
    color: #8B5CF6;
    text-style: bold;
}

#help-close-hint {
    text-style: italic;
    color: #cbc3d7;
    text-align: center;
    margin: 1 0 0 0;
    height: 1;
}

CommitScreen {
    background: #181622 85%;
    align: center middle;
    height: 3;
}

#commit-modal {
    background: #0f0d18;
    border: round #8B5CF6;
    color: #e6e0f1;
    width: 50;
    max-width: 90%;
    height: 13;
    padding: 0;
}

#commit-modal-title {
    text-style: bold;
    color: #e6e0f1;
    background: #201e2a;
    padding: 0 1;
    height: 1;
    text-align: center;
}

#commit-modal-input {
    width: 100%;
    height: 1fr;
    background: #1c1a26;
    color: #e6e0f1;
    border: round #494454;
    padding: 0 1;
    margin: 1;
}

#commit-modal-input:focus {
    border: round #8B5CF6;
}

#commit-modal-input .input--cursor {
    color: #3c0091;
    background: #8B5CF6;
}

HelpScreen {
    background: #181622 80%;
    align: center middle;
}

BranchScreen {
    background: #181622 85%;
    align: center middle;
}

#branch-modal {
    background: #0f0d18;
    border: round #8B5CF6;
    color: #e6e0f1;
    width: 50;
    max-width: 90%;
    height: auto;
    padding: 0;
}

#branch-modal-title {
    text-style: bold;
    color: #e6e0f1;
    background: #201e2a;
    padding: 0 1;
    text-align: center;
    height: 1;
}

#branch-option-list {
    background: #1c1a26;
    color: #e6e0f1;
    border: round #494454;
    height: auto;
    max-height: 60%;
    margin: 1 1 0 1;
}

#branch-option-list > .option-list--option-highlighted {
    background: #8B5CF6;
    color: #3c0091;
}

#branch-modal-hint {
    text-style: italic;
    color: #cbc3d7;
    text-align: center;
    height: 1;
    margin: 1 0 0 0;
}

CommitLogScreen {
    background: #181622 85%;
    align: center middle;
}

#commit-log-modal {
    background: #0f0d18;
    border: round #8B5CF6;
    color: #e6e0f1;
    width: 70%;
    max-width: 90%;
    height: 80%;
    max-height: 85%;
    padding: 0;
}

#commit-log-modal #commit-log {
    height: 1fr;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 0 1;
    color: #e6e0f1;
    background: transparent;
    scrollbar-visibility: hidden;
}

Toast {
    background: #1c1a26;
    border: round #494454;
    padding: 0 1;
}

Toast.-information {
    border: round #10B981;
}

Toast.-information .toast-title {
    color: #10B981;
}

Toast.-error {
    border: round #ffb4ab;
}

Toast.-error .toast-title {
    color: #ffb4ab;
}

Toast.-warning {
    border: round #ffb783;
}

Toast.-warning .toast-title {
    color: #ffb783;
}
/* ── Error line (skeleton K2 / structure T3) ─────────────────────────────
   Persistent contextual error strip: what happened → next action + key.
   Red family per surface V1/V3 tokens; hidden unless an error exists.   */
#error-line {
    height: 1;
    background: #3a1d1d;
    color: #ffb4ab;
}

/* ── Commit panel (skeleton K1) ──────────────────────────────────────────
   Permanent bottom panel: a board BLOCK like files/diff — flush with the
   bento (no margin), border + background driven by the block-active /
   block-inactive classes so it illuminates exactly like its siblings.
   The editor inside is one borderless writing area on the app's input
   background (#201e2a).                                              */
#commit-panel {
    height: auto;
    padding: 0 1;
}

#commit-context {
    color: #9c60ec;
    text-style: bold;
    height: 1;
}

#commit-message {
    background: #201e2a;
    border: none;
    height: 4;
    padding: 0 1;
    margin: 0;
}

/* Neutralize Textual's focus boost: the writing area stays quiet (V2) —
   the blinking caret alone shows where you type. (The cursor-line
   highlight is disabled via highlight_cursor_line=False in the widget.) */
#commit-message:focus {
    background: #201e2a;
    border: none;
}

#commit-affordance {
    color: #908fa0;
    height: 1;
}

#branch-name-input {
    margin: 1 1 0 1;
}
